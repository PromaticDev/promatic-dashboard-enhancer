      <!-- Priority Strip LOC -->

      <div class="priority-strip-loc">
        <div class="widget gs-widget">
          <div class="widget__head"><span class="widget__title">Golden Score</span></div>
          <div class="widget__body">
            <div class="gauge-wrap" id="gauge-lop"></div>
          </div>
          <div class="widget__footer"><a class="widget-btn" href="#" title="Abrir Safety Score en PILOT">Ver en PILOT
              ›</a></div>
        </div>
        <div class="widget alerts-widget">
          <div class="widget__head"><span class="widget__title">Últimas Alertas</span><span
              class="widget__meta">events.php + ptm</span></div>
          <div class="widget__body">
            <!-- <div class="alert-subtitle">Últimas 24h</div> -->
            <div class="chip-group">
              <a class="chip" href="#" title="Abrir alertas de Desconexión + intermitencia en PILOT"><span
                  class="chip-icon" style="color:var(--status-alert-strong)"><svg viewBox="0 0 18 18" fill="none"
                    stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 7a9 9 0 0 1 12 0" />
                    <path d="M6 10a5 5 0 0 1 6 0" />
                    <circle cx="9" cy="14" r="1" fill="currentColor" stroke="none" />
                    <line x1="2" y1="2" x2="16" y2="16" />
                  </svg></span>Señal GPS<span class="chip-count"
                  style="background:var(--status-alert-strong)">2</span></a>
              <a class="chip" href="#" title="Abrir alertas de Accidentes en PILOT"><span class="chip-icon"
                  style="color:var(--status-danger-strong)"><svg viewBox="0 0 18 18" fill="none" stroke="currentColor"
                    stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9 2 L16.5 15.5 H1.5 Z" />
                    <line x1="9" y1="7" x2="9" y2="11" />
                    <circle cx="9" cy="13.2" r="0.9" fill="currentColor" stroke="none" />
                  </svg></span>Accidentes<span class="chip-count"
                  style="background:var(--status-danger-strong)">0</span></a>
              <a class="chip" href="#" title="Abrir alertas de Requiere mantención en PILOT"><span class="chip-icon"
                  style="color:var(--status-warn-strong)"><svg viewBox="0 0 18 18" fill="none" stroke="currentColor"
                    stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M11.5 3a3 3 0 0 0-3.9 3.9L2.5 12l1.5 1.5 5.1-5.1a3 3 0 0 0 3.9-3.9l-2 2-1.5-1.5z" />
                  </svg></span>Requiere mantención<span class="chip-count"
                  style="background:var(--status-warn-strong)">2</span></a>
              <a class="chip" href="#" title="Abrir alertas de En taller en PILOT"><span class="chip-icon"
