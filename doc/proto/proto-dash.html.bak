                </div>
                <div class="heat-legend">
                  <span class="heat-cell heat-cell--offline"></span>offline
                  <span class="heat-cell heat-cell--parked"></span>estacionado
                  <span class="heat-cell heat-cell--moving"></span>en movimiento
                </div>
              </div>
              <div class="fleet-stats">
                <div class="fleet-stat-row"><b>89%</b>Activos</div>
                <div class="fleet-stat-row"><b>59%</b>En movimiento</div>
                <div class="fleet-stat-row"><b>30%</b>Estacionado</div>
                <div class="fleet-stat-row"><b>11%</b>Sin conexión</div>
              </div>
            </div>
          </div>
          <div class="widget__footer"><a class="widget-btn" href="#" title="Abrir árbol de flota en PILOT">Ver en PILOT
              ›</a></div>
        </div>
        <div class="widget dg-4">
          <div class="widget__head"><span class="widget__title">Top 5 · Vehículos con más KM Recorridos.</span><span
              class="widget__meta">rt=4</span></div>
          <div class="widget__body">
            <div class="km-widget-body">
              <div class="km-stack-wrap">
                <div class="stacked-track stacked-track--v">
                  <div class="stacked-seg" style="height:4%;background:var(--g2)" title="PRKP58 — 210km"></div>
                  <div class="stacked-seg" style="height:17%;background:var(--g1)" title="TFWS-89 — 980km"></div>
                  <div class="stacked-seg" style="height:21%;background:var(--g3)" title="KHSS78 — 1180km"></div>
                  <div class="stacked-seg" style="height:25%;background:var(--g4)" title="HYWX66 — 1420km"></div>
                  <div class="stacked-seg" style="height:33%;background:var(--g5)" title="RBBV51 — 1840km"></div>
                </div>
                <div class="km-stack-total"><b>5630</b>km top 5</div>
              </div>
              <div class="km-top5">
                <div class="km-date-range">SEMANA DEL: 13-08-2026 — 19-08-2026</div>
                <div class="km-top5-label">Ranking &middot; más recorrido</div>
                <a class="rank-row emphasized" href="#" data-veh="RBBV51"
                  title="Ver reporte de RBBV51 (runReport)"><span class="name">RBBV51</span>
