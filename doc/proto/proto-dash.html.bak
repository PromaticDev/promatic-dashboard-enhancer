<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Promatic Dashboard — Fase 2: Forma en escala de grises (RAC / LOP), 1 pantalla</title>
  <link rel="stylesheet" href="proto-styles.css">
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <link rel="icon" href="data:,">
</head>

<body>

  <div class="frame-label">Simulación de viewport de PILOT — <b>1522 × 900px</b> (base 18 ago en notebook era 648px de
    alto; ampliado 19 ago para monitor externo). Si algo se corta acá, se corta en PILOT.</div>

  <div class="pilot-frame">
    <div class="tabs">
      <button class="tab-btn active" data-view="rac">Vista RAC — Rental Car (flota propia)</button>
      <button class="tab-btn" data-view="lop">Vista LOP — Cliente arrendatario</button>
    </div>

    <!-- ===================== VISTA RAC ===================== -->
    <section class="view active" id="view-rac">

      <!-- AI Strip Section -->

      <div class="ai-strip">
        <div class="widget placeholder-card clock-widget">
          <div class="clock-label">Hora exacta Chile</div>
          <div class="clock-time" id="clock-time-rac">00:00:00</div>
        </div>
        <div class="widget search-widget">
          <div class="search-inner">
            <input type="text" class="search-input" id="search-input-rac"
              placeholder="Buscar un reporte… (ej. Ralentí, Eco Drive)" autocomplete="off">
            <div class="search-suggestions" id="search-suggestions-rac"></div>
            <span class="search-hint">Autocompletado dummy — catálogo de reportes PILOT, sin conexión real
              todavía</span>
          </div>
        </div>
        <div class="widget placeholder-card logo-widget">
          <svg class="logo-dummy" viewBox="0 0 140 70" xmlns="http://www.w3.org/2000/svg">
            <rect x="1" y="1" width="138" height="68" rx="10" class="logo-dummy__bg" />
            <circle cx="35" cy="35" r="14" class="logo-dummy__mark logo-dummy__mark--a" />
            <circle cx="50" cy="35" r="14" class="logo-dummy__mark logo-dummy__mark--b" />
            <text x="92" y="41" class="logo-dummy__text" text-anchor="middle">LOGO</text>
          </svg>
        </div>
      </div>

      <!-- Top Section -->

      <div class="priority-strip">


        <!-- GS Widget -->
        <div class="widget gs-widget">
          <div class="widget__head"><span class="widget__title">Golden Score</span></div>
          <div class="widget__body">
            <div class="gauge-wrap" id="gauge-rac"></div>
          </div>
          <div class="widget__footer"><a class="widget-btn" href="#" title="Abrir Safety Score en PILOT">Ver en PILOT
              ›</a></div>
        </div>
        <!-- Alerts Widget -->
        <div class="widget alerts-widget">
          <div class="widget__head"><span class="widget__title">Últimas Alertas</span><span
              class="widget__meta">events.php + ptm</span></div>
          <div class="widget__body">
            <!-- <div class="alert-subtitle">Últimas 24h</div> -->
            <div class="alert-5col">
              <div class="alert-stat">
                <div class="l">Señal GPS</div>
                <div class="n">2</div>
                <a class="action" href="#" title="Abrir alertas de Señal GPS (desconexión + intermitencia) en PILOT">Ver
                  Señal GPS</a>
              </div>
              <div class="alert-stat">
                <div class="l">Accidentes</div>
                <div class="n">1</div>
                <a class="action" href="#" title="Abrir alertas de Accidentes en PILOT">Ver Accidentes</a>
              </div>
              <div class="alert-stat">
                <div class="l">Requiere mantención</div>
                <div class="n">2</div>
                <a class="action" href="#" title="Abrir alertas de Requiere mantención en PILOT">Ver Mantención</a>
              </div>
              <div class="alert-stat">
                <div class="l">En taller</div>
                <div class="n">1</div>
                <a class="action" href="#" title="Abrir alertas de En taller en PILOT">Ver Taller</a>
              </div>
              <div class="alert-stat">
                <div class="l">Conducción</div>
                <div class="n">9</div>
                <a class="action" href="#" title="Abrir alertas de Conducción en PILOT">Ver Conducción</a>
              </div>
            </div>
          </div>
        </div>
        <!-- Eco Widget -->
        <div class="widget eco-widget">
          <div class="widget__head"><span class="widget__title">Velocidad de conducción</span><span
              class="widget__meta">speeding_pie.php</span></div>
          <div class="widget__body">
            <div class="speed-body">
              <div class="speed-donut-wrap" id="donut-rac"></div>
              <div class="speed-legend">
                <div class="speed-legend-item"><span class="speed-swatch bg-status-ok"></span>Despacio
                </div>
                <div class="speed-legend-item"><span class="speed-swatch bg-status-warn"></span>Normal
                </div>
                <div class="speed-legend-item"><span class="speed-swatch bg-status-alert"></span>Al límite
                </div>
                <div class="speed-legend-item"><span class="speed-swatch bg-status-danger"></span>Exceso
                </div>
              </div>
              <div class="speed-top5">
                <div class="km-top5-label">Top 5 &middot; excesos de vel.</div>
                <a class="rank-row emphasized" href="#" data-veh="PRKP58"
                  title="Ver reporte de PRKP58 (runReport)"><span class="name">PRKP58</span>
                  <div class="rank-track">
                    <div class="rank-fill" style="width:100%"></div>
                  </div><span class="rank-val">14x</span><span class="chev">›</span>
                </a><a class="rank-row" href="#" data-veh="RBBV51" title="Ver reporte de RBBV51 (runReport)"><span
                    class="name">RBBV51</span>
                  <div class="rank-track">
                    <div class="rank-fill" style="width:57%"></div>
                  </div><span class="rank-val">8x</span><span class="chev">›</span>
                </a><a class="rank-row" href="#" data-veh="HYWX66" title="Ver reporte de HYWX66 (runReport)"><span
                    class="name">HYWX66</span>
                  <div class="rank-track">
                    <div class="rank-fill" style="width:36%"></div>
                  </div><span class="rank-val">5x</span><span class="chev">›</span>
                </a><a class="rank-row" href="#" data-veh="KHSS78" title="Ver reporte de KHSS78 (runReport)"><span
                    class="name">KHSS78</span>
                  <div class="rank-track">
                    <div class="rank-fill" style="width:21%"></div>
                  </div><span class="rank-val">3x</span><span class="chev">›</span>
                </a><a class="rank-row" href="#" data-veh="TFWS-89" title="Ver reporte de TFWS-89 (runReport)"><span
                    class="name">TFWS-89</span>
                  <div class="rank-track">
                    <div class="rank-fill" style="width:7%"></div>
                  </div><span class="rank-val">1x</span><span class="chev">›</span>
                </a>
              </div>
            </div>
          </div>
          <div class="widget__footer"><a class="widget-btn" href="#"
              title="Abrir reporte de excesos de velocidad en PILOT">Ver en PILOT ›</a></div>
        </div>
      </div>

      <!-- Mid Section -->

      <div class="dense-grid">
        <div class="widget dg-4">
          <div class="widget__head"><span class="widget__title">ESTADO DE FLOTA</span><span
              class="widget__meta">online_tree.status</span></div>
          <div class="widget__body">
            <div class="fleet-body">
              <div class="fleet-heatmap">
                <div class="fleet-total"><b>64</b> vehículos &mdash; 1 celda = 1 vehículo</div>
                <div class="heat-grid">
                  <div class="heat-cell heat-cell--moving" title="Vehículo 1 — moving"></div>
                  <div class="heat-cell heat-cell--moving" title="Vehículo 2 — moving"></div>
                  <div class="heat-cell heat-cell--moving" title="Vehículo 3 — moving"></div>
                  <div class="heat-cell heat-cell--moving" title="Vehículo 4 — moving"></div>
