            <rect x="1" y="1" width="138" height="68" rx="10" class="logo-dummy__bg" />
            <circle cx="35" cy="35" r="14" class="logo-dummy__mark logo-dummy__mark--a" />
            <circle cx="50" cy="35" r="14" class="logo-dummy__mark logo-dummy__mark--b" />
            <text x="92" y="41" class="logo-dummy__text" text-anchor="middle">LOGO</text>
          </svg>
